void INIT_ULTRA() {
  for (uint8_t i = 0; i < SENSOR_COUNT; i++) {
    digitalWrite(shutdownPins[i], LOW);
    pinMode(shutdownPins[i], OUTPUT);
  }

  delay(10);
  Wire.begin();

  for (uint8_t i = 0; i < SENSOR_COUNT; i++) {
    pinMode(shutdownPins[i], INPUT);
    delay(10);
    if (!sensors[i].begin()) {
      stopWithError(i, "Sensor not found. Check wiring.");
    }
    if (!sensors[i].setAddress(addresses[i])) {
      stopWithError(i, "Failed to change I2C address.");
    }
  }
}
void Move(int speedL, int speedR, int timer) {
  motor(speedL, speedR);
  delay(timer);
}

